# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Secrets and local overrides - never commit these
.env
.env.*
!.env.example
config/*.local.yaml

# Runtime output generated by the application
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep
data/*
!data/.gitkeep
*.db
*.sqlite3

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db